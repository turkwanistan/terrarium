; Terrarium art-first Godot decision gate. No simulation/state authority lives here.
config_version=5

[application]
config/name="Terrarium Hero Art Gate"
run/main_scene="res://scenes/main.tscn"

[display]

[display/window]
size/viewport_width=400
size/viewport_height=240
size/window_width_override=800
size/window_height_override=480
stretch/mode="canvas_items"
stretch/aspect="keep"
stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[environment]
defaults/default_clear_color=Color(0.0784314, 0.0705882, 0.0666667, 1)
